/dts-v1/;

#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include <dt-bindings/sound/qcom,q6afe.h>
#include <dt-bindings/sound/qcom,q6asm.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/usb/pd.h>
#include "sm8250.dtsi"
#include "pm8150.dtsi"
#include "pm8150b.dtsi"
#include "pm8150l.dtsi"
#include "pm8009.dtsi"

/delete-node/ &adsp_mem;
/delete-node/ &cdsp_mem;
/delete-node/ &cdsp_secure_heap;
/delete-node/ &gpu_mem;
/delete-node/ &removed_mem;
/delete-node/ &slpi_mem;
/delete-node/ &spss_mem;
/delete-node/ &video_mem;
/delete-node/ &xbl_aop_mem;

/*
 * 下面这些上游 sm8250.dtsi 的保留区在 thyme 上全部落在 ABL 的 removed
 * 区内(0x80b00000-0x8b9fffff,见下面 removed_mem 的注释),而 thyme 把
 * removed_mem 扩到厂商真值 0xaf00000 之后就整个把它们盖住了,内核因此报
 *
 *   OF: reserved mem: OVERLAP DETECTED!
 *   memory@80b00000 (...) overlaps with memory@86200000 (...)
 *
 * (检测只比较排序后相邻两项,所以 7 个重叠只打印第 1 条。)
 *
 * 这几个区在 thyme 上都没有消费者,而且在 sm8250.dtsi 里本身就是无人引用
 * 的占位区:camera/npu/cvp 没有对应的驱动节点,dtsi 里也完全没有 ipa 节点
 * (crypto@1dfa000 之后直接跳到 tcsr_mutex@1f40000),wlan_mem 是 WCN 内置
 * WiFi 用的、而 thyme 的 WiFi 是 PCIe 上的 QCA6390(ath11k)。
 *
 * 删掉它们只是消除重叠和布局歧义,【不回收任何内存】—— 那 175MB 本来就被
 * removed_mem 整块标成 nomap 了。
 *
 * 以后真要启用这些子系统,不能把节点加回来了事(上游地址在 removed 区内,
 * 一访问就锁 NoC),得照厂商真值重定义,见下面 cdsp_mem 注释里的完整布局表:
 *   camera 0x8be00000+0x500000  wlan_fw 0x8c300000+0x100000
 *   ipa_fw 0x8c400000+0x10000   ipa_gsi 0x8c410000+0xa000
 *   npu    0x8c500000+0x500000  cvp     0x8cf00000+0x500000
 */
/delete-node/ &camera_mem;
/delete-node/ &cvp_mem;
/delete-node/ &ipa_fw_mem;
/delete-node/ &ipa_gsi_mem;
/delete-node/ &npu_mem;
/delete-node/ &wlan_mem;

/ {
	model = "Xiaomi Mi 10S (thyme)";
	compatible = "xiaomi,thyme", "qcom,sm8250";
	chassis-type = "handset";

	/* Required for the bootloader (ABL) to select this DTB. */
	qcom,msm-id = <0x164 0x20001>;
	qcom,board-id = <0x2d 0>; /* board-id 45 */

	aliases {
		serial0 = &uart2;
	};

	chosen {
		stdout-path = "serial0:115200n8";

		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * Continuous splash framebuffer left by the bootloader
		 * (cont_splash_region@9c000000 in the stock DTB).
		 * 1080x2340 XRGB8888.
		 *
		 * NOTE: if the screen stays black on the device, verify the
		 * framebuffer address/stride and adjust this node, then
		 * rebuild the DTB.
		 */
		framebuffer: framebuffer@9c000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x9c000000 0x0 0x2300000>;
			width = <1080>;
			height = <2340>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};
	
	memory {
		ddr_device_type = <0x08>;
		device_type = "memory";
		#address-cells = <2>;
		#size-cells = <2>;
		reg = 	<0x0 0x80000000 0x0 0x3b800000>,
				<0x1 0x80000000 0x1 0x0>,
				<0x0 0xc0000000 0x0 0xc0000000>;
	};

	sdx55m-modem {
		compatible = "qcom,sdx55m-modem";
		pinctrl-0 = <&mdm2ap_default>, <&ap2mdm_default>;
		pinctrl-names = "default";
		qcom,modem-pon = <&modem_pon>;

		ap2mdm-status-gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
		ap2mdm-errfatal-gpios = <&tlmm 57 GPIO_ACTIVE_LOW>;
		mdm2ap-status-gpios = <&tlmm 3 GPIO_ACTIVE_HIGH>;
		mdm2ap-errfatal-gpios = <&tlmm 1 GPIO_ACTIVE_HIGH>;
	};

	wcd938x: audio-codec {
		compatible = "qcom,wcd9380-codec";
		status = "okay";
		reset-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;

		vdd-buck-supply = <&vreg_s4a_1p8>;
		vdd-rxtx-supply = <&vreg_s4a_1p8>;
		vdd-io-supply = <&vreg_s4a_1p8>;
		vdd-mic-bias-supply = <&vreg_bob>;

		qcom,micbias1-microvolt = <1800000>;
		qcom,micbias2-microvolt = <1800000>;
		qcom,micbias3-microvolt = <1800000>;
		qcom,micbias4-microvolt = <1800000>;
		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
		qcom,rx-device = <&wcd_rx>;
		qcom,tx-device = <&wcd_tx>;

		#sound-dai-cells = <1>;
	};

	battery: battery {
		compatible = "simple-battery";
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4450000>;
		charge-full-design-microamp-hours = <4780000>;
		energy-full-design-microwatt-hours = <18400000>;
	};

	/*
	 * No mainline fuel gauge for PM8150B FG-GEN4; estimate capacity from
	 * the VBAT_SNS ADC channel (drivers/power/supply/pm8150b-bat.c).
	 */
	thyme-battery {
		compatible = "xiaomi,thyme-battery";
		io-channels = <&pm8150b_adc ADC5_VBAT_SNS>;
		io-channel-names = "vbat_sns";
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		// stdout-path = "serial0:115200n8";
		// stdout-path = "display0";
		bootargs = "root=/dev/sda38 rw rootwait";
		//  pd_ignore_unused clk_ignore_unused 
		display0: framebuffer@9c000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x9c000000 0x0 0x2300000>;
			width = <1080>;
			height = <2340>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
			status = "disabled";
			/*
			 * That's a lot of clocks, but it's necessary due
			 * to unused clk cleanup & no panel driver yet..
			 */
			// clocks = <&dispcc DISP_CC_MDSS_AHB_CLK>,
			// 	 <&gcc GCC_DISP_HF_AXI_CLK>,
			// 	 <&gcc GCC_DISP_SF_AXI_CLK>,
			// 	 <&dispcc DISP_CC_MDSS_VSYNC_CLK>,
			// 	 <&dispcc DISP_CC_MDSS_MDP_CLK>,
			// 	 <&dispcc DISP_CC_MDSS_BYTE0_CLK>,
			// 	 <&dispcc DISP_CC_MDSS_BYTE0_INTF_CLK>,
			// 	 <&dispcc DISP_CC_MDSS_PCLK0_CLK>,
			// 	 <&dispcc DISP_CC_MDSS_ESC0_CLK>;
			// power-domains = <&dispcc MDSS_GDSC>;
		};
	};

	qca6390-pmu {
		compatible = "qcom,qca6390-pmu";

		pinctrl-names = "default";
		pinctrl-0 = <&bt_en_state>, <&wlan_en_state>;

		vddaon-supply = <&vreg_s6a_0p95>;
		vddpmu-supply = <&vreg_s2f_0p95>;
		vddrfa0p95-supply = <&vreg_s2f_0p95>;
		vddrfa1p3-supply = <&vreg_s8c_1p3>;
		vddrfa1p9-supply = <&vreg_s5a_1p9>;
		vddpcie1p3-supply = <&vreg_s8c_1p3>;
		vddpcie1p9-supply = <&vreg_s5a_1p9>;
		vddio-supply = <&vreg_s4a_1p8>;

		wlan-enable-gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
		bt-enable-gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;

		regulators {
			vreg_pmu_rfa_cmn: ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn";
			};

			vreg_pmu_aon_0p59: ldo1 {
				regulator-name = "vreg_pmu_aon_0p59";
			};

			vreg_pmu_wlcx_0p8: ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
			};

			vreg_pmu_wlmx_0p85: ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p85";
			};

			vreg_pmu_btcmx_0p85: ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p85";
			};

			vreg_pmu_rfa_0p8: ldo5 {
				regulator-name = "vreg_pmu_rfa_0p8";
			};

			vreg_pmu_rfa_1p2: ldo6 {
				regulator-name = "vreg_pmu_rfa_1p2";
			};

			vreg_pmu_rfa_1p7: ldo7 {
				regulator-name = "vreg_pmu_rfa_1p7";
			};

			vreg_pmu_pcie_0p9: ldo8 {
				regulator-name = "vreg_pmu_pcie_0p9";
			};

			vreg_pmu_pcie_1p8: ldo9 {
				regulator-name = "vreg_pmu_pcie_1p8";
			};
		};
	};

	thermal-zones {
		camera-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150l_adc_tm 0>;

			trips {
				active-config0 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "passive";
				};
			};
		};

		conn-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150b_adc_tm 0>;

			trips {
				active-config0 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "passive";
				};
			};
		};

		mmw-pa1-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150_adc_tm 2>;

			trips {
				active-config0 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "passive";
				};
			};
		};

		mmw-pa2-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150l_adc_tm 2>;

			trips {
				active-config0 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "passive";
				};
			};
		};

		skin-msm-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150l_adc_tm 1>;

			trips {
				active-config0 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "passive";
				};
			};
		};

		skin-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150_adc_tm 1>;

			trips {
				active-config0 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "passive";
				};
			};
		};

		xo-thermal {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&pm8150_adc_tm 0>;

			trips {
				active-config0 {
					temperature = <125000>;
					hysteresis = <1000>;
					type = "passive";
				};
			};
		};
	};

	// slimbam: dma-controller@3a84000 {
	// 	compatible = "qcom,bam-v1.7.4", "qcom,bam-v1.7.0";
	// 	reg = <0x0 0x3a84000 0x0 0x2c000>;
