	// 	iommus = <&apps_smmu 0x1826 0x00>;
	// };

	// slim_msm: slim-ngd@3ac0000  {
	// 	compatible = "qcom,slim-ngd-v1.5.0";
	// 	reg = <0 0x3ac0000 0 0x2c000>;
	// 	interrupts = <GIC_SPI 163 IRQ_TYPE_LEVEL_HIGH>;
	// 	dmas = <&slimbam 3>, <&slimbam 4>;
	// 	dma-names = "rx", "tx";
	// 	#address-cells = <1>;
	// 	#size-cells = <0>;
	// 	iommus = <&apps_smmu 0x1830 0x01>,
	// 			<&apps_smmu 0x182f 0x00>;
	// 	status = "disabled";
	// };

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
	};

	vreg_s4a_1p8: pm8150-s4 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_s4a_1p8";

		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;

		regulator-always-on;
		regulator-boot-on;

		vin-supply = <&vph_pwr>;
	};

	vreg_s6c_0p88: smpc6-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vreg_s6c_0p88";

		regulator-min-microvolt = <880000>;
		regulator-max-microvolt = <880000>;
		regulator-always-on;
		vin-supply = <&vph_pwr>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		key-vol-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pm8150_gpios 6 GPIO_ACTIVE_LOW>;
		};
	};

	vdd_boost_vreg: vdd_boost_vreg {
		compatible = "regulator-fixed";
		regulator-name = "vdd_boost_vreg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		startup-delay-us = <4000>;
		enable-active-high;
		regulator-always-on;
		gpio = <&pm8150b_gpios 5 0>;
	 };

	ext_5v_boost: ext-5v-boost {
		status = "okay";
		compatible = "regulator-fixed";
		gpio = <&pm8150b_gpios 12 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&otg_vbus_boost>;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-enable-ramp-delay = <1600>;
		regulator-name = "ext_5v_boost";
		enable-active-high;
	};

	touch_vddio_vreg: touch_vddio_vreg {
		status = "okay";
		compatible = "regulator-fixed";
		regulator-name = "disp_vddio_vreg";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		enable-active-high;
		gpio = <&tlmm 69 0>;
	};

	reserved-memory {
		xbl_aop_mem: memory@80600000 {
			reg = <0x0 0x80600000 0x0 0x260000>;
			no-map;
		};

		xbl_uefi_log: memory@80880000 {
			reg = <0x0 0x80880000 0x0 0x14000>;
			no-map;
		};

		/*
		 * Bootloader TZ/hyp "removed" region on thyme. Vendor DT:
		 * removed_region@80b00000 + 0xaf00000 (ends 0x8ba00000).
		 * The inherited upstream size (0x5300000) leaves small holes
		 * (e.g. 0x85e00000-0x86200000) that Linux hands out as System
		 * RAM; any CPU access there XPU-faults and locks the NoC.
		 */
		removed_mem: memory@80b00000 {
			reg = <0x0 0x80b00000 0x0 0xaf00000>;
			no-map;
		};

		/*
		 * Zap shader carveout = vendor pil_gpu_region@8c41a000.
		 * The inherited MTP address (0x8681a000, step2c: 0x86820000)
		 * sits inside the removed region above, so the very first CPU
		 * read of the region hangs the NoC (XPU) before any SCM call.
		 */
		gpu_mem: memory@8c41a000 {
			reg = <0x0 0x8c41a000 0x0 0x2000>;
			no-map;
		};

		/*
		 * venus/iris 的固件区 = 厂商 pil_video_region@8ca00000。
		 * 继承来的上游地址 0x86e00000 落在 removed_mem 里,而 iris 驱动是
		 * memremap 这块区再让 qcom_mdt_load 往里写固件的(iris_firmware.c:
		 * of_reserved_mem_region_to_resource -> memremap -> qcom_mdt_load),
		 * 所以第一次 CPU 写就会 XPU 违例锁 NoC —— 比 gpu_mem 更凶,因为
		 * zap 只是读、这里要写。大小 0x500000 与厂商一致,只改起始地址。
		 */
		video_mem: memory@8ca00000 {
			reg = <0x0 0x8ca00000 0x0 0x500000>;
			no-map;
		};

		/*
		 * CDSP 的 PIL 固件区 = 厂商 pil_cdsp_region@0x8d400000。
		 *
		 * 上游地址 0x87800000 落在 removed_mem (0x80b00000-0x8b9fffff)
		 * 里面 —— 和当初 gpu_mem(0x8681a000)、video_mem(0x86e00000) 是同一个
		 * 错误,而且 remoteproc 的 PAS 流程要 CPU 先 memremap 这块区、再把固件
		 * memcpy 进去,所以第一次写就会 XPU 违例锁 NoC、整机挂死。
		 *
		 * 现在没炸只是因为固件不存在:
		 *   remoteproc1: Direct firmware load for qcom/sm8250/umi/cdsp.mbn
		 *                failed with error -2
		 * 也就是说这是一颗埋着的雷 —— 谁往 /lib/firmware 里放一份 cdsp.mbn,
		 * 下次开机就挂。
		 *
		 * 厂商 pil_* 区是严格连续排布的(地址均取自实机反编译 DT):
		 *   camera 0x8be00000+0x500000   wlan_fw 0x8c300000+0x100000
		 *   ipa_fw 0x8c400000+0x10000    ipa_gsi 0x8c410000+0xa000
		 *   gpu    0x8c41a000+0x2000     npu     0x8c500000+0x500000
		 *   video  0x8ca00000+0x500000   cvp     0x8cf00000+0x500000
		 *   cdsp   0x8d400000+0x1400000  slpi    0x8e800000+0x2f00000
		 *   adsp   0x91700000+0x2500000  spss    0x93c00000+0x100000
		 *   cdsp_secure_heap 0x93d00000+0x4600000
		 * 注意 cdsp 前面还夹着 cvp(0x8cf00000),所以 cdsp 不是紧跟 video 的
		 * 0x8cf00000 而是 0x8d400000 —— 按「video 之后就是 cdsp」推会错 5MB。
		 */
		cdsp_mem: memory@8d400000 {
			reg = <0x0 0x8d400000 0x0 0x1400000>;
			no-map;
		};

		slpi_mem: memory@8e800000 {
			reg = <0x0 0x8e800000 0x0 0x2f00000>;
			no-map;
		};

		adsp_mem: memory@91700000 {
			reg = <0x0 0x91700000 0x0 0x2500000>;
			no-map;
		};

		/*
		 * 以下两区对齐厂商 pil_spss_region@93c00000 / cdsp_secure_heap@93d00000。
		 * 继承来的 0x8e000000 / 0x8e100000 大小对、起始地址错(跟 gpu_mem 当初
		 * 从 0x8681a000 修成 0x8c41a000 是同一类错误):cdsp_secure_heap 从
		 * 0x8e100000 延伸 0x4600000 会一直盖到 0x92700000,把 slpi_mem
		 * (0x8e800000+0x2f00000)整个吞掉、并压住 adsp_mem(0x91700000+0x2500000)
		 * 的前 16MB —— adsp 的 PAS 区被别人占着,remoteproc 起不来。
		 */
		spss_mem: memory@93c00000 {
			reg = <0x0 0x93c00000 0x0 0x100000>;
			no-map;
		};

		cdsp_secure_heap: memory@93d00000 {
			reg = <0x0 0x93d00000 0x0 0x4600000>;
			no-map;
		};
		
		dfps_data_region: memory@9e300000 {
			reg = <0x0 0x9e300000 0x0 0x100000>;
			no-map;
		};

		disp_rdump_region: memory@b0400000 {
			reg = <0x0 0xb0400000 0x0 0x1000000>;
			no-map;
		};

		/*
		 * fastrpc 的 DMA coherent 池(&adsp 下面 glink-edge/fastrpc 的
		 * memory-region 指向这里)。
		 *
		 * 必须带 compatible = "shared-dma-pool":fastrpc 走的是
		 * of_reserved_mem_device_init_by_idx(),它要调 rmem->ops->device_init,
		 * 而 ops 只有在节点的 compatible 匹配上某个 RESERVEDMEM_OF_DECLARE
		 * 时才会被填。只有 reg + no-map 的裸节点 ops 为 NULL,于是返回
		 * -EINVAL,日志里就是那句
		 *   qcom,fastrpc ...: no reserved DMA memory for FASTRPC
		 * —— memory-region 写了却完全没生效。
		 *
		 * no-map 要保留:rmem_dma_setup() 里拒绝 no-map 的那段是
		 * #ifdef CONFIG_ARM(32 位)的,arm64 走 rmem_dma_device_init ->
		 * dma_init_coherent_memory -> memremap(..., MEMREMAP_WC),对 nomap
		 * 保留区正是标准路径(zap shader 区也是这么 memremap 的)。
		 */
		adsp_dma_mem: memory@9e400000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x9e400000 0x0 0xc00000>;
			no-map;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			size = <0x0 0x8000000>;
			reusable;
			linux,cma-default;
		};

		cont_splash_mem: memory@9c000000 {
			reg = <0x0 0x9c000000 0x0 0x2300000>;
			no-map;
		};

		ramoops@b0000000 {
			compatible = "ramoops";
			/*
			 * 0xb0000000 is where the stock MIUI and TWRP kernels
			 * actually attach ramoops, via Xiaomi's downstream
			 * "ramoops_memreserve=4M" cmdline mechanism
			 * (msm_reserve_ramoops_memory, console-only layout,
			 * record_size=0). The devicetree node at 0xA9800000 in
			 * the stock DT loses the pstore-backend race and never
			 * takes effect — do not "align" to it. Keeping this
			 * address means a warm reboot into TWRP (preferred, no
			 * log-scrubbing services) or MIUI exposes this kernel's
			 * console log in /sys/fs/pstore. Console zone must stay
			 * at offset 0 (record-size = 0) to match downstream.
			 */
			reg = <0x0 0xb0000000 0x0 0x400000>;
			record-size = <0>;
			console-size = <0x200000>;
			ftrace-size = <0x100000>;
			pmsg-size = <0x100000>;
			ecc-size = <0>;
		};
	};
};

&pm8150b_vbus {
	regulator-min-microamp = <500000>;
	regulator-max-microamp = <3000000>;
	status = "okay";
};

/*
 * Reboot reasons, consumed by qcom-pon (drivers/power/reset/qcom-pon.c):
 * reboot-mode matches the string passed to reboot(LINUX_REBOOT_CMD_RESTART2)
 * against these property names and writes the magic into the PMIC's
 * PON_SOFT_RB_SPARE register, where ABL reads it back to pick a boot target.
 *
 * The match is exact and a missing property means the register is not
 * written at all, so a mode absent here is not "default behaviour" - it is
 * a plain reboot. That is what makes "recovery"/"bootloader" silently land
 * in Android instead of recovery/fastboot.
 *
 * Values are the same as upstream sm8250-mtp.dts (same SoC, same PMIC).
 */
&pon {
	mode-bootloader = <0x2>;
	mode-fastboot = <0x2>;
	mode-recovery = <0x1>;
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	status = "okay";
	linux,code = <KEY_VOLUMEDOWN>;
};

&adsp {
	status = "okay";
	firmware-name = "qcom/sm8250/umi/adsp.mbn";
	glink-edge {
		fastrpc {
			memory-region = <&adsp_dma_mem>;
		};
	};
};

