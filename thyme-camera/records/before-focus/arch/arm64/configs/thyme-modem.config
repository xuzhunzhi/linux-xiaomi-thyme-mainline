# External SDX55 over PCIe/MHI (thyme and apollo).
CONFIG_PCI=y
CONFIG_MHI_BUS=y
CONFIG_MHI_BUS_PCI_GENERIC=y
CONFIG_MHI_BUS_SAHARA_MODEM=y
CONFIG_QRTR=y
CONFIG_QRTR_MHI=y
# WWAN is limited to a module if GNSS is a module.
CONFIG_GNSS=y
CONFIG_WWAN=y
CONFIG_MHI_WWAN_CTRL=y
CONFIG_MHI_NET=y
CONFIG_RMNET=y
CONFIG_QCOM_ESOC=y
CONFIG_QCOM_ESOC_DEV=y
CONFIG_QCOM_ESOC_CLIENT=y
CONFIG_QCOM_ESOC_MDM_4X=y
CONFIG_QCOM_ESOC_MDM_DRV=y
CONFIG_INPUT_QPNP_POWER_ON=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y

CONFIG_MHI_BUS_BL_LOGGER=y
# CONFIG_MHI_BUS_CHAN_KEEPALIVE is not set
# CONFIG_MHI_BUS_SATELLITE is not set
CONFIG_QCOM_ESOC_DBG_ENG=y
CONFIG_QCOM_ESOC_DBG_REQ_ENG=y
CONFIG_DEBUG_FS=y
CONFIG_LOCALVERSION="-sm8250-modem"

# Xiaomi Mi 10S raw camera capture
CONFIG_VIDEO_S5KHMX=y
CONFIG_VIDEO_S5K3T2=y
CONFIG_VIDEO_OV13B10=y
CONFIG_VIDEO_QCOM_CAMSS=y
CONFIG_I2C_QCOM_CCI=y
